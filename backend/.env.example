REDMINE_BASE_URL=https://support.qwysoft.com
PORT=4000

# Set to "production" when deploying (enables secure cookies + serving the
# built frontend). Leave unset for local development.
NODE_ENV=

# There is no shared REDMINE_API_KEY here anymore — each teammate logs in
# with their own Redmine API key via the app's login screen, and it is held
# server-side in memory for their session only.
