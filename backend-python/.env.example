REDMINE_BASE_URL=https://support.qwysoft.com
PORT=4001

# Set to "production" when deploying (enables secure cookies + serving the
# built frontend). Leave unset for local development.
ENVIRONMENT=

# There is no shared REDMINE_API_KEY here — each teammate logs in with their
# own Redmine API key via the app's login screen, held server-side in memory
# for their session only.

# Free-tier key from https://aistudio.google.com/apikey — powers the read-only ticket
# chatbot. Leave unset to disable that feature; nothing else in the app depends on it.
GEMINI_API_KEY=
